# ветвления и циклы
пускай x = 15
если (x > 20) { гойда("много") } иначе если (x > 10) { гойда("средне") } иначе { гойда("мало") }

пускай n = 0
пока (n < 10) {
    n = n + 1
    если (n % 2 == 0) { продолжи }
    если (n > 7) { прерви }
    пиши(строка(n) + " ")
}
гойда("")

для (пускай i = 0; i < 5; i += 1) { пиши(i * i + " ") }
гойда("")

для (пускай v в [10, 20, 30]) { пиши(v + " ") }
гойда("")

цикл {
    x = x - 1
    если (x == 12) { прерви }
}
гойда("x =", x)
