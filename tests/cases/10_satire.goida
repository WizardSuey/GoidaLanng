# Сатирические алиасы синтаксиса и ядра.
импортозамещение "тест_модуль" как местный
иноагент "тест_модуль" как внешний

гойда(всёидётпоплану, потужно, замерзающаяевропа)
гойда(аналоговнет замерзающаяевропа)
гойда(паляниця(42), ZOV)
паникинет("значение отброшено")

пускай цифры = ""
затридня (пускай i = 0; i < 3; i += 1) {
    цифры += паляниця(i)
}

если (замерзающаяевропа) {
    гойда("сюда нельзя")
} гдевыбыли {
    гойда(цифры, местный.удвой(2), внешний.константа)
}
