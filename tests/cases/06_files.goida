подключить "файлы"

пускай путь = "/tmp/goida_test_06.txt"
файлы.запиши_файл(путь, "первая строка\nвторая строка\n")
гойда(файлы.существует(путь))
гойда(файлы.прочитай_файл(путь))

пускай f = файлы.открой(путь, "r")
гойда(f.строка())
гойда(f.строка())
пускай поймано = f.строка()
гойда(поймано == пусто)
f.закрой()
