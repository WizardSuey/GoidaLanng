подключить "массивы"

пускай a = [5, 3, 8, 1, 8]
гойда(массивы.сортируй(a))
гойда(массивы.сумма(a))
гойда(массивы.сверни(a, дело (acc, x) { верни acc * 10 + x }, 0))
гойда(массивы.срежь(a, 1, 4))
гойда(массивы.переверни(a))
гойда(массивы.включает(a, 8), массивы.позиция(a, 8))

пускай люди = [{имя: "иван", возр: 30}, {имя: "аня", возр: 21}]
пускай по_имени = массивы.сортируй_по(люди, дело (ч) { верни ч.имя })
гойда(по_имени[0].имя, по_имени[1].имя)

пускай m = {a: 1, b: 2, c: 3}
гойда(ключи(m))
гойда(значения(m))
гойда(есть(m, "b"), есть(m, "z"))
m["d"] = 4
гойда(длина(m))
