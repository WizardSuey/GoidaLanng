# дела, рекурсия, замыкания
дело fib(n) {
    если (n < 2) { верни n }
    верни fib(n - 1) + fib(n - 2)
}
пускай res = []
для (пускай i = 0; i < 10; i = i + 1) { добавь(res, fib(i)) }
гойда(res)

дело привет(имя, знак = "!") { верни имя + знак }
гойда(привет("ziv"))
гойда(привет("ziv", "??"))

дело счётчик(старт = 0) {
    пускай n = старт
    верни дело () { n = n + 1; верни n }
}
пускай a = счётчик()
пускай b = счётчик(100)
a(); a()
b()
гойда(a(), b())

# анонимные дела и колбэки
дело примени(f, x) { верни f(x) }
гойда(примени(дело (v) { верни v * 3 }, 14))

# foreach даёт свежую привязку на итерацию
пускай fns = []
для (пускай i в [1, 2, 3]) { добавь(fns, дело () { верни i * 10 }) }
гойда(fns[0](), fns[1](), fns[2]())
