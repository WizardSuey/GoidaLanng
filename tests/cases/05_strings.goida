подключить "строки"

пускай s = "Гойда, Мир!"
гойда(строки.регистр_вверх(s))
гойда(строки.регистр_вниз(s))
гойда(строки.подрежь(s, 0, 5))
гойда(строки.найди(s, "Мир"))
гойда(строки.содержит(s, "мир"))
гойда(строки.замени(s, "Мир", "мир"))
гойда(строки.раздели("а,б,в", ","))
гойда(строки.соедини(["г", "о", "й", "д", "а"], "-"))
гойда(строки.обрежь("  простор  "))
гойда("а" + 1 + 2.5 + истина)
