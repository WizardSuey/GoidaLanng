# нагрузка на сборщик: корректность после множества сборок
пускай acc = 0
для (пускай i = 0; i < 50000; i = i + 1) {
    пускай s = "строка " + строка(i)
    пускай a = [s, s + s]
    acc = acc + длина(a[1]) % 3
}
гойда("acc:", acc)
пускай f = дело (n) {
    пускай локаль = "x" + строка(n)
    верни дело () { верни локаль }
}
пускай g = f(777)
гойда(g())
