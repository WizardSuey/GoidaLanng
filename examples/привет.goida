# Привет, мир! по-гойдовски.
# Запуск: ./goida examples/привет.goida

подключить "строки"
подключить "массивы"

гойда("Привет, мир!")
гойда(ZOV, "— константа-баннер")

# переменные и вывод
пускай язык = "GoidaLang"
гойда("Это", язык, "версии", версия)

# условия
пускай x = 42
если (x > 40) {
    гойда("больше сорока")
} иначе если (x == 40) {
    гойда("ровно сорок")
} иначе {
    гойда("меньше")
}

# дела (функции) с дефолтами
дело привет(имя, знак = "!") {
    верни "Здорово, " + имя + знак
}
гойда(привет("боец"))
гойда(привет("боец", "!!!"))

# циклы
для (пускай i = 1; i <= 3; i = i + 1) {
    пиши("итерация ", i, "; ")
}
гойда("")

пускай счёт = 0
пока (счёт < 5) {
    если (счёт == 3) { счёт = счёт + 1; продолжи }
    счёт = счёт + 1
}
гойда("счёт =", счёт)

# foreach с новой привязкой на итерацию
для (пускай буква в ["г", "о", "й", "д", "а"]) {
    пиши(строки.регистр_вверх(буква))
}
гойда("")

# коллекции
пускай числа = [3, 1, 4, 1, 5, 9, 2, 6]
гойда("сорт:", массивы.сортируй(числа))
гойда("чётные:", массивы.отфильтруй(числа, дело (n) { верни n % 2 == 0 }))
гойда("квадраты:", массивы.отобрази(числа, дело (n) { верни n * n }))

# словари и методы на них
дело новый_стек() {
    верни {
        данные: [],
        положить: дело (я, x) { добавь(я.данные, x); верни я },
        снять: дело (я) { верни выкинь(я.данные) }
    }
}
пускай стек = новый_стек()
стек.положить(1).положить(2)
гойда("со стека:", стек.снять(), стек.снять())

# мемный и сатирический слой
шепни("это ушло в stderr")
база(2 + 2 == 4, "математика сломалась")
понятно()   # no-op: «понятно, идём дальше»
респект([1, "два", пусто])
паникинет("значение отброшено")
если (аналоговнет замерзающаяевропа) {
    гойда(ZOV, "— всё идёт по плану:", всёидётпоплану, "потужно:", потужно)
} гдевыбыли {
    дискредитация("неудобный результат")
}
