# TCP echo-сервер: принимает одного клиента, возвращает строки заглавными.
подключить "сокеты"
подключить "строки"

пускай srv = сокеты.Сервер("127.0.0.1", 8099)
srv.слушай()
гойда("сервер слушает на", srv.адрес())

пускай conn = srv.прими()
гойда("клиент пришёл")

цикл {
    пускай строка = conn.получи_строку()
    если (строка == пусто) { прерви }
    conn.отправь_строку(строки.регистр_вверх(строка))
}
conn.закрой()
srv.закрой()
гойда("сервер закончил")
