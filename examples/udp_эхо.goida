# UDP-эхо в одном файле: без аргументов — клиент, с «__сервер» — сервер.
# Запуск из корня репозитория: ./goida examples/udp_эхо.goida
подключить "сокеты"
подключить "система"
подключить "время"

дело сервер() {
    пускай d = сокеты.Датаграм()
    d.привяжи("127.0.0.1", 9123)
    пускай п = d.получи()
    d.отправь("эхо: " + п.данные, п.хост, п.порт)
    d.закрой()
}

дело клиент() {
    # поднимем сервер отдельным процессом
    система.выполни("./goida examples/udp_эхо.goida __сервер &")
    время.спи(300)
    пускай d = сокеты.Датаграм()
    d.отправь("гойда по udp", "127.0.0.1", 9123)
    пускай п = d.получи()
    гойда("получено:", п.данные, "от", п.хост + ":" + строка(п.порт))
    d.закрой()
}

пускай аргс = система.аргументы()
если (длина(аргс) > 0 и аргс[0] == "__сервер") {
    сервер()
} иначе {
    клиент()
}
